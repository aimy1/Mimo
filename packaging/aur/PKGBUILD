# Maintainer: aisaniya <aimy1@github.com>
pkgname=mimo-bin
_pkgname=mimo
pkgver=1.4.3
pkgrel=1

pkgdesc="Minimalist Mihomo Manager - Modern Linux Terminal TUI & CLI Proxy Control Center"
arch=('x86_64' 'aarch64')
url="https://github.com/aimy1/Mimo"
license=('MIT')
provides=('mimo')
conflicts=('mimo')
depends=('glibc' 'ca-certificates')
optdepends=('libcap: for TUN mode network capability management without sudo')

source_x86_64=("${url}/releases/download/v${pkgver}/mimo-${pkgver}-x86_64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/mimo-${pkgver}-aarch64.tar.gz")

sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cd "${srcdir}/mimo-${CARCH}"
    install -Dm755 mimo "${pkgdir}/usr/bin/mimo"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
}
